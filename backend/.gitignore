/target
*.csv

# Local runtime state (SQLite position/state DB) — differs per machine/run,
# never something to commit.
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets & local overrides — NEVER commit these
.env
.env.*
config.local.toml
config.*.toml
!config.toml
secrets/
*.key
*.pem
*.p12
*.pfx

# IDE artifacts
.idea/
.vscode/

# Profiling / flamegraph output
perf.data
perf.data.old
flamegraph.svg
*.folded

# Graphify output
graphify-out/

# Temp scan directories
temp_scan/
